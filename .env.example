# ══════════════════════════════════════════════════════════════════
#  Money Matters AI — Backend Environment Variables
#  Copy this file to .env for local development.
#  For Render/Railway/Fly.io: set these in the platform's env vars UI.
# ══════════════════════════════════════════════════════════════════

# ── Runtime Environment ───────────────────────────────────────────
# Set to "production" to enable CORS restrictions and other prod guards
ENV=development

# ── CORS — Frontend Origins ───────────────────────────────────────
# Primary frontend URL (Vercel deployment URL or custom domain)
# Example: https://money-matters.vercel.app
FRONTEND_URL=http://localhost:3000

# Additional allowed origins (comma-separated, optional)
# Example: https://custom-domain.com,https://preview.vercel.app
EXTRA_ORIGINS=

# ── Server Self-Reference (for keep-alive & cache warm-up) ────────
# Render sets RENDER_EXTERNAL_URL automatically — no need to set manually on Render.
# For other platforms (Railway, Fly.io, etc.), set APP_BASE_URL:
# Example: https://your-app.railway.app
APP_BASE_URL=

# ── Gemini / Google AI (for sentiment analysis) ───────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq (optional fast LLM — used if GEMINI_API_KEY is not set) ──
GROQ_API_KEY=your_groq_api_key_here

# ── Supabase (if backend connects to Supabase directly) ───────────
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
